flowchart TB
    cliente["Aplicación cliente<br/>(API compatible con OpenAI)"]
    consola["Consola de operación<br/>Next.js 15"]

    subgraph ingreso["Gateway Nebula (FastAPI) · 1. Ingreso del pedido"]
        direction LR
        auth["Autenticación<br/>X-Nebula-API-Key → tenant"] --> rl["Limitador por tenant<br/>token bucket"] --> emb["Embedding del prompt<br/>(uno por pedido)"] --> pol["Resolución de política<br/>presupuestos, modelos permitidos"]
    end
    subgraph decision["Gateway Nebula (FastAPI) · 2. Decisión y atención"]
        direction LR
        art[/"Artefacto del router<br/>learned_router_v1.json"/] -.->|carga al iniciar| router["Router de tres niveles<br/>dos logísticas + umbrales"] --> cache["Caché semántico<br/>aislado por tenant, TTL, umbral"] -->|miss| prov["Proveedores<br/>local · económico · frontier<br/>fallback local → premium"] --> ledger["Ledger de uso<br/>costo, ruta, motivo, señales"]
        cache -->|hit| ledger
    end
    admin["Gateway Nebula (FastAPI)<br/>API de administración /v1/admin/*"]

    subgraph datos["Almacenes"]
        direction LR
        pg[("PostgreSQL 16<br/>tenants, políticas, claves, ledger")]
        qd[("Qdrant<br/>vectores del caché")]
    end

    subgraph modelos["Modelos"]
        direction LR
        ol["Ollama (local)<br/>qwen2.5:7b · nomic-embed-text"]
        orr["OpenRouter (externo)<br/>claude-haiku-4.5 · gpt-4.1"]
    end

    cliente -->|POST /v1/chat/completions| ingreso
    consola --> admin
    ingreso -->|vector del prompt| decision
    decision <-->|caché · ledger| datos
    ingreso -->|política| datos
    decision -->|generación| modelos
    ingreso -->|embedding| modelos
    admin --> datos
